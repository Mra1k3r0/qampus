<!DOCTYPE html>
<html lang="en-PH">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#F7F4EC">
  <meta name="color-scheme" content="light dark">
  <meta name="description" content="Take a ticket for a CSPC office, watch your place in line, and show your code at the counter.">
  <title><%= appName %> | <%= title %></title>
  <%
    const pageDescription = 'Take a ticket for a CSPC office, watch your place in line, and show your code at the counter.';
    const isVerificationPage = currentPath === '/register/check-email' || currentPath === '/verify-email';
    const isResetPage = currentPath === '/forgot-password'
      || currentPath === '/forgot-password/sent'
      || currentPath === '/reset-password'
      || currentPath === '/reset-password/new';
    const pagePath = currentPath === '/' ? '/' : currentPath.replace(/\/+$/, '');
    const pageUrl = publicBaseUrl + pagePath;
    const socialImage = publicBaseUrl + assetUrl('/images/cspc/seal-512.png');
    let pageCssKey = 'base';
    if (currentPath === '/') {
      pageCssKey = 'home';
    } else if (currentPath === '/queue' || currentPath.indexOf('/queue/') === 0) {
      pageCssKey = 'queue';
    } else if (currentPath.indexOf('/staff/') === 0) {
      pageCssKey = 'staff';
    } else if (currentPath.indexOf('/admin/') === 0) {
      pageCssKey = 'admin';
    } else if (currentPath === '/profile') {
      pageCssKey = 'profile';
    } else if (currentPath === '/rules' || currentPath === '/privacy') {
      pageCssKey = 'policy';
    } else if (
      currentPath === '/login'
      || currentPath === '/register'
      || isVerificationPage
      || isResetPage
    ) {
      pageCssKey = 'auth';
    }
    const pageStylesheet = assetUrl(`/css/page-${pageCssKey}.min.css`);
    const structuredData = {
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: 'Qampus',
      url: pageUrl,
      description: pageDescription,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      inLanguage: 'en-PH',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'PHP',
      },
      provider: {
        '@type': 'Organization',
        name: 'CSPC CCIT',
      },
    };
  %>
  <link rel="canonical" href="<%= pageUrl %>">
  <meta property="og:title" content="<%= appName %> | <%= title %>">
  <meta property="og:description" content="<%= pageDescription %>">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= pageUrl %>">
  <meta property="og:image" content="<%= socialImage %>">
  <meta property="og:site_name" content="Qampus">
  <meta name="twitter:card" content="summary">
  <link rel="manifest" href="/site.webmanifest">
  <script type="application/ld+json"><%- JSON.stringify(structuredData) %></script>
  <link rel="icon" href="<%= assetUrl('/favicon.ico') %>" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="<%= assetUrl('/images/cspc/seal-32.png') %>">
  <link rel="apple-touch-icon" sizes="180x180" href="<%= assetUrl('/images/cspc/seal-180.png') %>">
  <script><%- themeBootstrap %></script>
  <script defer src="<%= assetUrl('/js/theme.min.js') %>"></script>
  <link rel="stylesheet" href="<%= pageStylesheet %>">
  <script defer src="<%= assetUrl('/js/app.min.js') %>"></script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>
  <%
    let roleLabel = '';
    if (user) {
      if (user.role === 'admin') {
        roleLabel = 'Office head';
      } else if (user.role === 'staff') {
        roleLabel = 'Staff';
      } else {
        roleLabel = 'Student';
      }
    }
    const isStaff = Boolean(user && (user.role === 'staff' || user.role === 'admin'));
    const isAdmin = Boolean(user && user.role === 'admin');
    const isStudent = Boolean(user && user.role === 'student');
    const isProfilePage = currentPath === '/profile';
    const accountInitials = user
      ? (user.initials || String(user.fullName || '').trim().split(/\s+/).slice(0, 2).map(function (part) { return part.charAt(0); }).join('').toUpperCase() || '?')
      : '';
    const isAuthPage = currentPath === '/login'
      || currentPath === '/register'
      || isVerificationPage
      || isResetPage;
    let activePageScript = typeof pageScript === 'string' && pageScript.length > 0
      ? pageScript
      : null;
    if (!activePageScript) {
      if (currentPath === '/queue' || currentPath.indexOf('/queue/') === 0) {
        activePageScript = '/js/queue.min.js';
      } else if (currentPath.indexOf('/staff/') === 0) {
        activePageScript = '/js/staff.min.js';
      } else if (
        currentPath === '/login'
        || currentPath === '/register'
        || isVerificationPage
        || currentPath === '/reset-password/new'
      ) {
        activePageScript = '/js/auth.min.js';
      } else if (currentPath === '/profile') {
        activePageScript = '/js/profile.min.js';
      }
    }
  %>
  <% if (isAuthPage) { %>
  <div class="auth-mark shell">
    <a class="brand" href="/">
      <% if (!isVerificationPage) { %>
      <img class="brand__seal" src="<%= assetUrl('/images/cspc/seal-64.webp') %>" srcset="<%= assetUrl('/images/cspc/seal-64.webp') %> 64w, <%= assetUrl('/images/cspc/seal-128.webp') %> 128w" sizes="(min-width: 768px) 42px, 38px" alt="" width="120" height="125">
      <% } %>
      <span class="brand__text">
        <span class="brand__name">Qampus</span>
        <span class="brand__meta">CCIT Service Desk</span>
      </span>
    </a>
  </div>
  <% } else { %>
  <header class="site-header">
    <div class="shell site-header__inner">
      <a class="brand" href="/">
        <img class="brand__seal" src="<%= assetUrl('/images/cspc/seal-64.webp') %>" srcset="<%= assetUrl('/images/cspc/seal-64.webp') %> 64w, <%= assetUrl('/images/cspc/seal-128.webp') %> 128w" sizes="(min-width: 768px) 42px, 38px" alt="" width="120" height="125">
        <span class="brand__text">
          <span class="brand__name">Qampus</span>
          <span class="brand__meta">CCIT Service Desk</span>
        </span>
      </a>

      <nav class="site-nav" aria-label="Main">
        <a class="nav-link nav-link--home<%= currentPath === '/' ? ' is-current' : '' %>" href="/"<%- currentPath === '/' ? ' aria-current="page"' : '' %>>Home</a>
        <a class="nav-link<%= currentPath === '/display' ? ' is-current' : '' %>" href="/display"<%- currentPath === '/display' ? ' aria-current="page"' : '' %>>Display</a>
        <% if (isStudent) { %>
        <a class="nav-link<%= currentPath === '/queue' ? ' is-current' : '' %>" href="/queue"<%- currentPath === '/queue' ? ' aria-current="page"' : '' %>>My queue</a>
        <% } %>
        <% if (isStaff) { %>
        <a class="nav-link<%= currentPath.indexOf('/staff/') === 0 ? ' is-current' : '' %>" href="/staff/queue"<%- currentPath.indexOf('/staff/') === 0 ? ' aria-current="page"' : '' %>>Staff queue</a>
        <% } %>
        <% if (isAdmin) { %>
        <a class="nav-link<%= currentPath === '/admin/services' ? ' is-current' : '' %>" href="/admin/services"<%- currentPath === '/admin/services' ? ' aria-current="page"' : '' %>>Service windows</a>
        <a class="nav-link<%= currentPath === '/admin/staff' ? ' is-current' : '' %>" href="/admin/staff"<%- currentPath === '/admin/staff' ? ' aria-current="page"' : '' %>>Staff accounts</a>
        <% } %>
        <% if (user) { %>
        <a class="account<%= isProfilePage ? ' is-current' : '' %>" href="/profile" title="Profile settings"<%- isProfilePage ? ' aria-current="page"' : '' %>>
          <% if (user.avatarUrl) { %>
          <img class="avatar avatar--account" src="<%= user.avatarUrl %>" alt="" width="32" height="32">
          <% } else { %>
          <span class="avatar avatar--account avatar--initials" aria-hidden="true"><%= accountInitials %></span>
          <% } %>
          <span class="account__text">
            <span class="account__name"><%= user.fullName %></span>
            <span class="account__role"><%= roleLabel %></span>
          </span>
          <span class="visually-hidden">Profile settings</span>
        </a>
        <form class="nav-logout" method="post" action="/logout" data-logout-form>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="nav-logout__button" type="submit" title="Sign out">
            <%- include('../partials/icon', { name: 'log-out', size: 20, title: null }) %>
            <span class="visually-hidden">Sign out</span>
          </button>
        </form>
        <% } else { %>
        <a class="nav-link" href="/login">Sign in</a>
        <a class="btn btn--primary btn--small" href="/register">
          Get started
          <%- include('../partials/icon', { name: 'arrow-right', size: 16, title: null }) %>
        </a>
        <% } %>
      </nav>

      <details class="mobile-menu">
        <summary class="mobile-menu__summary">
          <%- include('../partials/icon', { name: 'menu', size: 24, title: null }) %>
          <span class="visually-hidden">Open menu</span>
        </summary>
        <nav class="mobile-menu__panel" aria-label="Main menu">
          <div class="mobile-menu__head">
            <div class="mobile-menu__brand">
              <img class="mobile-menu__seal" src="<%= assetUrl('/images/cspc/seal-64.webp') %>" srcset="<%= assetUrl('/images/cspc/seal-64.webp') %> 64w, <%= assetUrl('/images/cspc/seal-128.webp') %> 128w" sizes="40px" alt="" width="120" height="125">
              <span>Qampus</span>
            </div>
            <button class="mobile-menu__close" type="button" data-close-menu aria-label="Close menu">
              <%- include('../partials/icon', { name: 'x', size: 24, title: null }) %>
            </button>
          </div>

          <div class="mobile-menu__body">
            <a class="mobile-menu__link<%= currentPath === '/' ? ' is-current' : '' %>" href="/"<%- currentPath === '/' ? ' aria-current="page"' : '' %>>Home</a>
            <a class="mobile-menu__link<%= currentPath === '/display' ? ' is-current' : '' %>" href="/display"<%- currentPath === '/display' ? ' aria-current="page"' : '' %>>Display</a>
            <% if (isStudent) { %>
            <a class="mobile-menu__link<%= currentPath === '/queue' ? ' is-current' : '' %>" href="/queue"<%- currentPath === '/queue' ? ' aria-current="page"' : '' %>>My queue</a>
            <% } %>
            <% if (isStaff) { %>
            <a class="mobile-menu__link<%= currentPath.indexOf('/staff/') === 0 ? ' is-current' : '' %>" href="/staff/queue"<%- currentPath.indexOf('/staff/') === 0 ? ' aria-current="page"' : '' %>>Staff queue</a>
            <% } %>
            <% if (isAdmin) { %>
            <a class="mobile-menu__link<%= currentPath === '/admin/services' ? ' is-current' : '' %>" href="/admin/services"<%- currentPath === '/admin/services' ? ' aria-current="page"' : '' %>>Service windows</a>
            <a class="mobile-menu__link<%= currentPath === '/admin/staff' ? ' is-current' : '' %>" href="/admin/staff"<%- currentPath === '/admin/staff' ? ' aria-current="page"' : '' %>>Staff accounts</a>
            <% } %>
          </div>

          <% if (user) { %>
          <div class="mobile-menu__foot">
            <a class="mobile-menu__account<%= isProfilePage ? ' is-current' : '' %>" href="/profile"<%- isProfilePage ? ' aria-current="page"' : '' %>>
              <% if (user.avatarUrl) { %>
              <img class="avatar avatar--drawer" src="<%= user.avatarUrl %>" alt="" width="44" height="44">
              <% } else { %>
              <span class="avatar avatar--drawer avatar--initials" aria-hidden="true"><%= accountInitials %></span>
              <% } %>
              <span class="mobile-menu__account-text">
                <span class="mobile-menu__account-name"><%= user.fullName %></span>
                <span class="mobile-menu__account-role"><%= roleLabel %></span>
              </span>
            </a>
            <form class="mobile-menu__logout" method="post" action="/logout" data-logout-form>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="mobile-menu__signout" type="submit" title="Sign out">
                <%- include('../partials/icon', { name: 'log-out', size: 20, title: null }) %>
                <span class="visually-hidden">Sign out</span>
              </button>
            </form>
          </div>
          <% } else { %>
          <div class="mobile-menu__foot mobile-menu__foot--guest">
            <a class="btn btn--secondary btn--block" href="/login">Sign in</a>
            <a class="btn btn--primary btn--block" href="/register">
              Get started
              <%- include('../partials/icon', { name: 'arrow-right', size: 16, title: null }) %>
            </a>
          </div>
          <% } %>
        </nav>
      </details>
    </div>
  </header>
  <% } %>

  <% if (user) { %>
  <dialog class="logout-dialog" data-logout-dialog aria-labelledby="logout-dialog-title" aria-describedby="logout-dialog-desc">
    <div class="logout-dialog__inner">
      <h2 class="logout-dialog__title" id="logout-dialog-title">Log out?</h2>
      <p class="logout-dialog__desc" id="logout-dialog-desc">Are you sure you want to log out?</p>
      <div class="logout-dialog__actions">
        <button class="btn btn--secondary" type="button" data-logout-cancel>Cancel</button>
        <button class="btn btn--primary" type="button" data-logout-confirm>Log out</button>
      </div>
    </div>
  </dialog>
  <% } %>

  <%- include('../partials/flash', { flash: flash }) %>

  <main class="site-main<%= currentPath === '/' ? ' site-main--home' : '' %>" id="main" tabindex="-1">
    <%- body %>
  </main>

  <% if (isStudent && currentPath !== '/display') { %>
  <%- include('../partials/call-watch') %>
  <% } %>

  <% if (!isAuthPage) { %>
  <footer class="site-footer">
    <div class="shell footer__grid">
      <div class="footer__col footer__col--brand">
        <p class="footer__brand">
          <img class="footer__logo" src="<%= assetUrl('/images/cspc/seal-64.webp') %>" srcset="<%= assetUrl('/images/cspc/seal-64.webp') %> 64w, <%= assetUrl('/images/cspc/seal-128.webp') %> 128w" sizes="36px" alt="" width="36" height="37">
          <span class="footer__wordmark">Qampus</span>
        </p>
        <p class="footer__about">A student queueing system for CSPC CCIT offices. Take a ticket, watch your place, and show your code at the counter.</p>
      </div>
      <div class="footer__col">
        <p class="footer__label">Office hours</p>
        <p>Monday to Friday<br>08:00 to 17:00 PHT</p>
      </div>
      <div class="footer__col">
        <p class="footer__label">Location</p>
        <p>CSPC Main Campus<br>CCIT Office, Window 1</p>
      </div>
      <div class="footer__col">
        <p class="footer__label">Help</p>
        <p><a href="/#how-it-works">How the queue works</a></p>
      </div>
    </div>
    <div class="shell footer__base">
      <div class="footer__base-start">
        <p>&copy; 2026 qampus.dpdns.org</p>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Current theme: Light. Activate to switch to Dark.">
          <span class="theme-toggle__icon theme-toggle__icon--sun">
            <%- include('../partials/icon', { name: 'sun', size: 16, title: null }) %>
          </span>
          <span class="theme-toggle__icon theme-toggle__icon--moon">
            <%- include('../partials/icon', { name: 'moon', size: 16, title: null }) %>
          </span>
          <span class="theme-toggle__icon theme-toggle__icon--star">
            <%- include('../partials/icon', { name: 'star', size: 16, title: null }) %>
          </span>
          <span class="theme-toggle__label" data-theme-label>Light</span>
        </button>
      </div>
      <p class="footer__legal">
        <a href="/rules">Terms</a>
        <a href="/privacy">Policy</a>
      </p>
    </div>
  </footer>
  <% } %>

  <% if (activePageScript) { %>
  <script src="<%= assetUrl(activePageScript) %>" defer></script>
  <% } %>
  <% if (isStudent && currentPath !== '/display') { %>
  <script src="<%= assetUrl('/js/call-watch.min.js') %>" defer></script>
  <% } %>
</body>
</html>
