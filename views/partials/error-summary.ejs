<%#
  Error summary contract.
  Include with lines (plain text rows) or fields (labeled rows).
  Include with: include('../partials/error-summary', { errors: errors, lines: ['Enter your password.'] })
  Include with: include('../partials/error-summary', { errors: errors, fields: [{ name: 'email', label: 'Email' }] })
  Renders when lines are present, errors.form exists, or any listed field has an error.
%>
<%
  const errorBag = errors && typeof errors === 'object' ? errors : {};
  const fieldList = typeof fields === 'undefined' || !Array.isArray(fields) ? [] : fields;
  const lineList = typeof lines === 'undefined' || !Array.isArray(lines) ? [] : lines.filter(Boolean);
  const fieldHits = fieldList.filter(function (field) {
    return Boolean(errorBag[field.name]);
  });
  const hasSummary = lineList.length > 0 || Boolean(errorBag.form) || fieldHits.length > 0;
%>
<% if (hasSummary) { %>
<div class="error-summary" role="alert" tabindex="-1" data-error-summary>
  <h2 class="error-summary__title">
    <%- include('./icon', { name: 'circle-alert', size: 20, title: null }) %>
    There is a problem
  </h2>
  <ul class="error-summary__list">
    <% if (lineList.length > 0) { %>
    <% lineList.forEach(function (line) { %>
    <li><%= line %></li>
    <% }); %>
    <% } else { %>
    <% if (errorBag.form) { %>
    <li><%= errorBag.form %></li>
    <% } %>
    <% fieldHits.forEach(function (field) { %>
    <li><a href="#<%= field.id || field.name %>"><%= field.label %>: <%= errorBag[field.name] %></a></li>
    <% }); %>
    <% } %>
  </ul>
</div>
<% } %>
