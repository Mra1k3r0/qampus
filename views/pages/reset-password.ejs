<%
  const errorBag = typeof errors !== 'undefined' && errors && typeof errors === 'object'
    ? errors
    : {};
  const valuesBag = typeof values !== 'undefined' && values && typeof values === 'object'
    ? values
    : {};
  const valueEmail = typeof valuesBag.email === 'string' ? valuesBag.email : '';
  const modelEmail = typeof email === 'string' ? email.trim() : '';
  const emailValue = valueEmail || modelEmail;
  const codeValue = typeof valuesBag.code === 'string' ? valuesBag.code : '';
  const missing = typeof missingFields !== 'undefined' && Array.isArray(missingFields)
    ? missingFields
    : [];
  const emailMissing = missing.includes('email');
  const codeMissing = missing.includes('code');
  const emailError = errorBag.email || (emailMissing ? 'Enter your email address.' : '');
  const codeError = errorBag.code || (codeMissing ? 'Enter the 8-digit code from the email.' : '');
  const token = typeof csrfToken !== 'undefined' && typeof csrfToken === 'string'
    ? csrfToken
    : '';
  const summaryLines = [];

  if (errorBag.form) {
    summaryLines.push(errorBag.form);
  }

  if (emailMissing) {
    summaryLines.push('Enter your email address.');
  } else if (errorBag.email) {
    summaryLines.push(errorBag.email);
  }

  if (codeMissing) {
    summaryLines.push('Enter the 8-digit code from the email.');
  } else if (errorBag.code) {
    summaryLines.push(errorBag.code);
  }
%>
<div class="auth auth--single shell">
  <div class="auth-form">
    <form class="form" method="post" action="/reset-password" novalidate>
      <div class="auth-form__intro">
        <h1 class="auth-form__title">Reset password</h1>
        <p class="auth-form__sub">Enter the email and the 8-digit code.</p>
      </div>

      <input type="hidden" name="_csrf" value="<%= token %>">

      <%- include('../partials/error-summary', {
        errors: errorBag,
        lines: summaryLines,
      }) %>

      <div class="field<%= emailError ? ' field--error' : '' %>">
        <label class="field__label" for="email">Email</label>
        <input
          class="input"
          id="email"
          name="email"
          type="email"
          value="<%= emailValue %>"
          autocomplete="email"
          inputmode="email"
          maxlength="160"
          required
          <% if (emailError) { %>aria-describedby="email-error" aria-invalid="true"<% } %>
        >
        <% if (emailError) { %>
        <p class="field__error" id="email-error">
          <%- include('../partials/icon', { name: 'circle-alert', size: 16, title: null }) %>
          <%= emailError %>
        </p>
        <% } %>
      </div>

      <div class="field<%= codeError ? ' field--error' : '' %>">
        <label class="field__label" for="code">8-digit code</label>
        <input
          class="input auth-code__input"
          id="code"
          name="code"
          type="text"
          value="<%= codeValue %>"
          inputmode="numeric"
          autocomplete="one-time-code"
          autocapitalize="off"
          spellcheck="false"
          maxlength="8"
          pattern="[0-9]{8}"
          required
          <% if (codeError) { %>aria-describedby="code-error" aria-invalid="true"<% } %>
        >
        <% if (codeError) { %>
        <p class="field__error" id="code-error">
          <%- include('../partials/icon', { name: 'circle-alert', size: 16, title: null }) %>
          <%= codeError %>
        </p>
        <% } %>
      </div>

      <button class="btn btn--primary btn--block" type="submit">Continue</button>

      <p class="form__foot"><a href="/forgot-password">Send a new code</a></p>
    </form>
  </div>
</div>
