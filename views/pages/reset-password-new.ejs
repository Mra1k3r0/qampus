<%
  const errorBag = typeof errors !== 'undefined' && errors && typeof errors === 'object'
    ? errors
    : {};
  const missing = typeof missingFields !== 'undefined' && Array.isArray(missingFields)
    ? missingFields
    : [];
  const passwordMissing = missing.includes('password');
  const confirmMissing = missing.includes('confirmPassword');
  const passwordError = errorBag.password || (passwordMissing ? 'Enter your new password.' : '');
  const confirmError = errorBag.confirmPassword || (confirmMissing ? 'Confirm your new password.' : '');
  const token = typeof csrfToken !== 'undefined' && typeof csrfToken === 'string'
    ? csrfToken
    : '';
  const firstFieldError = [errorBag.password, errorBag.confirmPassword].find(Boolean);
  const summaryLines = [];

  if (missing.length >= 2) {
    summaryLines.push('Enter and confirm your new password.');
  } else if (passwordMissing) {
    summaryLines.push('Enter your new password.');
  } else if (confirmMissing) {
    summaryLines.push('Confirm your new password.');
  } else if (errorBag.form) {
    summaryLines.push(errorBag.form);
  } else if (firstFieldError) {
    summaryLines.push(firstFieldError);
  }
%>
<div class="auth auth--single shell">
  <div class="auth-form">
    <form class="form" method="post" action="/reset-password/new" novalidate>
      <div class="auth-form__intro">
        <h1 class="auth-form__title">Set a new password</h1>
        <p class="auth-form__sub">Use at least 8 characters with a letter and a number.</p>
      </div>

      <input type="hidden" name="_csrf" value="<%= token %>">

      <%- include('../partials/error-summary', {
        errors: errorBag,
        lines: summaryLines,
      }) %>

      <div class="field<%= passwordError ? ' field--error' : '' %>">
        <label class="field__label" for="password">Password</label>
        <div class="field__control">
          <input
            class="input"
            id="password"
            name="password"
            type="password"
            autocomplete="new-password"
            minlength="8"
            maxlength="200"
            pattern="(?=.*[A-Za-z])(?=.*[0-9]).{8,200}"
            required
            <% if (passwordError) { %>aria-describedby="password-error" aria-invalid="true"<% } %>
          >
          <button
            class="field__reveal"
            type="button"
            data-password-toggle="password"
            aria-controls="password"
            aria-pressed="false"
            aria-label="Show password"
            hidden
          >
            <span data-password-icon="show"><%- include('../partials/icon', { name: 'eye', size: 20, title: null }) %></span>
            <span data-password-icon="hide" hidden><%- include('../partials/icon', { name: 'eye-off', size: 20, title: null }) %></span>
          </button>
        </div>
        <% if (passwordError) { %>
        <p class="field__error" id="password-error">
          <%- include('../partials/icon', { name: 'circle-alert', size: 16, title: null }) %>
          <%= passwordError %>
        </p>
        <% } %>
      </div>

      <div class="field<%= confirmError ? ' field--error' : '' %>">
        <label class="field__label" for="confirmPassword">Confirm password</label>
        <div class="field__control">
          <input
            class="input"
            id="confirmPassword"
            name="confirmPassword"
            type="password"
            autocomplete="new-password"
            minlength="8"
            maxlength="200"
            required
            <% if (confirmError) { %>aria-describedby="confirmPassword-error" aria-invalid="true"<% } %>
          >
          <button
            class="field__reveal"
            type="button"
            data-password-toggle="confirmPassword"
            aria-controls="confirmPassword"
            aria-pressed="false"
            aria-label="Show confirm password"
            hidden
          >
            <span data-password-icon="show"><%- include('../partials/icon', { name: 'eye', size: 20, title: null }) %></span>
            <span data-password-icon="hide" hidden><%- include('../partials/icon', { name: 'eye-off', size: 20, title: null }) %></span>
          </button>
        </div>
        <% if (confirmError) { %>
        <p class="field__error" id="confirmPassword-error">
          <%- include('../partials/icon', { name: 'circle-alert', size: 16, title: null }) %>
          <%= confirmError %>
        </p>
        <% } %>
      </div>

      <button class="btn btn--primary btn--block" type="submit">Update password</button>
    </form>
  </div>
</div>
