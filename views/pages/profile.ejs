<%
  const identity = profile && typeof profile === 'object' ? profile : {};
  const choices = Array.isArray(avatarChoices) ? avatarChoices : [];
  const formValues = values && typeof values === 'object' ? values : {};
  const errorBag = errors && typeof errors === 'object' ? errors : {};
  const nameValue = formValues.fullName !== undefined && formValues.fullName !== null
    ? formValues.fullName
    : identity.fullName || '';
  const avatarUrl = identity.avatarUrl || '';
  const initials = identity.initials || '?';
  const studentNoLabel = identity.studentNo || 'Not on file';
  const memberSinceLabel = identity.memberSinceLabel || 'Not on file';
%>
<div class="shell page page--profile">
  <header class="page-head profile-page__head">
    <p class="eyebrow">Account</p>
    <h1 class="page-head__title">Profile settings.</h1>
    <p class="page-head__lede">Update the name and photo the service desk sees.</p>
  </header>

  <div class="profile-layout">
    <aside class="profile-identity" aria-labelledby="identity-name">
      <div class="profile-identity__top">
        <% if (avatarUrl) { %>
        <img class="profile-avatar" src="<%= avatarUrl %>" alt="" width="120" height="120">
        <% } else { %>
        <span class="profile-avatar profile-avatar--initials" aria-hidden="true"><%= initials %></span>
        <% } %>
        <div class="profile-identity__text">
          <p class="profile-identity__role"><%= identity.roleLabel || 'Account' %></p>
          <h2 class="profile-identity__name" id="identity-name"><%= identity.fullName %></h2>
        </div>
      </div>

      <dl class="profile-facts">
        <div>
          <dt>Student number</dt>
          <dd class="mono"><%= studentNoLabel %></dd>
        </div>
        <div>
          <dt>Email</dt>
          <dd><%= identity.email %></dd>
        </div>
        <div>
          <dt>Member since</dt>
          <dd><%= memberSinceLabel %></dd>
        </div>
      </dl>

      <p class="profile-identity__note">Your photo is used only inside Qampus. You can change or remove it at any time.</p>
    </aside>

    <div class="profile-stack">
      <section class="profile-panel" aria-labelledby="photo-title">
        <div class="profile-panel__head">
          <p class="eyebrow">Photo</p>
          <h2 class="profile-panel__title" id="photo-title">Your photo</h2>
          <p class="profile-panel__lede">Pick a preset or upload your own. A clear photo makes your account easy to recognize.</p>
        </div>

        <% if (errorBag.avatar) { %>
        <p class="field__error" id="avatar-error" role="alert">
          <%- include('../partials/icon', { name: 'circle-alert', size: 16, title: null }) %>
          <%= errorBag.avatar %>
        </p>
        <% } %>

        <fieldset class="avatar-fieldset<%= errorBag.avatar ? ' field--error' : '' %>"<% if (errorBag.avatar) { %> aria-describedby="avatar-error"<% } %>>
          <legend class="avatar-fieldset__legend">Choose a preset photo</legend>
          <div class="avatar-grid">
            <% choices.forEach(function (choice) { %>
            <form class="avatar-choice" method="post" action="/profile/avatar/preset">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="preset" value="<%= choice.key %>">
              <button class="avatar-choice__button<%= choice.isSelected ? ' is-selected' : '' %>" type="submit" aria-pressed="<%= choice.isSelected ? 'true' : 'false' %>">
                <span class="avatar-choice__media">
                  <img class="avatar-choice__image" src="<%= choice.url %>" alt="" width="96" height="96">
                  <% if (choice.isSelected) { %>
                  <span class="avatar-choice__check">
                    <%- include('../partials/icon', { name: 'check', size: 16, title: null }) %>
                  </span>
                  <% } %>
                </span>
                <span class="avatar-choice__label"><%= choice.label %></span>
                <span class="avatar-choice__state"><%= choice.isSelected ? 'Selected' : '' %></span>
              </button>
            </form>
            <% }); %>
          </div>
        </fieldset>

        <div class="profile-photo-actions">
          <div class="profile-photo-actions__row">
            <form method="post" action="/profile/avatar/shuffle">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn--secondary btn--small" type="submit">
                <%- include('../partials/icon', { name: 'shuffle', size: 16, title: null }) %>
                Shuffle<span class="visually-hidden"> photo</span>
              </button>
            </form>
            <form method="post" action="/profile/avatar/clear">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn--quiet btn--small btn--danger" type="submit">
                <%- include('../partials/icon', { name: 'trash-2', size: 16, title: null }) %>
                Remove<span class="visually-hidden"> photo</span>
              </button>
            </form>
          </div>

          <form class="upload-form" method="post" action="/profile/avatar/upload" enctype="multipart/form-data" data-avatar-form>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="upload-form__body">
              <div class="upload-form__preview">
                <span class="field__label">Preview</span>
                <div class="avatar-preview" data-avatar-preview>
                  <% if (avatarUrl) { %>
                  <img class="avatar-preview__image" data-avatar-preview-image src="<%= avatarUrl %>" alt="Current profile photo" width="104" height="104">
                  <% } %>
                  <span class="avatar-preview__initials" data-avatar-preview-initials aria-hidden="true"<%= avatarUrl ? ' hidden' : '' %>><%= initials %></span>
                </div>
              </div>
              <div class="upload-form__field">
                <label class="field__label" for="avatar-upload">Upload a photo</label>
                <div class="upload-form__row">
                  <input
                    class="input upload-form__input"
                    id="avatar-upload"
                    name="avatar"
                    type="file"
                    accept="image/png,image/jpeg,image/webp"
                    required
                    data-avatar-input
                    aria-describedby="avatar-upload-hint<%= errorBag.avatar ? ' avatar-error' : '' %>"
                  >
                  <button class="btn btn--secondary" type="submit">
                    <%- include('../partials/icon', { name: 'save', size: 16, title: null }) %>
                    Save<span class="visually-hidden"> photo</span>
                  </button>
                </div>
                <p class="field__hint" id="avatar-upload-hint">PNG, JPEG, or WebP, up to 2 MB. Drag and zoom to crop to a square before saving.</p>
                <p class="upload-form__status" data-avatar-status role="status"></p>
              </div>
            </div>
          </form>
        </div>
      </section>

      <section class="profile-panel" aria-labelledby="name-title">
        <div class="profile-panel__head">
          <p class="eyebrow">Name</p>
          <h2 class="profile-panel__title" id="name-title">Display name</h2>
          <p class="profile-panel__lede">This name appears on your tickets and in the staff queue.</p>
        </div>

        <form class="form" method="post" action="/profile" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field<%= errorBag.fullName ? ' field--error' : '' %>">
            <label class="field__label" for="fullName">Full name</label>
            <input
              class="input"
              id="fullName"
              name="fullName"
              type="text"
              value="<%= nameValue %>"
              autocomplete="name"
              required
              aria-describedby="fullName-hint<%= errorBag.fullName ? ' fullName-error' : '' %>"
              <%- errorBag.fullName ? 'aria-invalid="true"' : '' %>
            >
            <p class="field__hint" id="fullName-hint">Use the name your teachers know you by.</p>
            <% if (errorBag.fullName) { %>
            <p class="field__error" id="fullName-error">
              <%- include('../partials/icon', { name: 'circle-alert', size: 16, title: null }) %>
              <%= errorBag.fullName %>
            </p>
            <% } %>
          </div>
          <div class="profile-form__foot">
            <button class="btn btn--primary" type="submit">Save name</button>
          </div>
        </form>
      </section>
    </div>
  </div>

  <dialog class="crop-dialog" data-crop-dialog aria-labelledby="crop-title" aria-describedby="crop-desc">
    <div class="crop-dialog__inner">
      <div class="crop-dialog__head">
        <p class="eyebrow">Photo</p>
        <h2 class="crop-dialog__title" id="crop-title">Adjust your photo</h2>
        <p class="crop-dialog__lede" id="crop-desc">Drag to reposition, then zoom to fit the square. Arrow keys also nudge the photo.</p>
      </div>
      <div class="crop-dialog__stage" data-crop-stage tabindex="0" aria-label="Photo crop area" aria-describedby="crop-desc">
        <img class="crop-dialog__image" data-crop-image src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg'/%3E" alt="" draggable="false">
      </div>
      <div class="field crop-dialog__zoom">
        <label class="field__label" for="crop-zoom">Zoom</label>
        <input class="crop-dialog__range" id="crop-zoom" data-crop-zoom type="range" min="1" max="3" step="0.01" value="1">
      </div>
      <div class="crop-dialog__actions">
        <button class="btn btn--secondary" type="button" data-crop-cancel>Cancel</button>
        <button class="btn btn--primary" type="button" data-crop-apply>Use photo</button>
      </div>
    </div>
  </dialog>
</div>
