<%
  const submittedEmail = typeof email !== 'undefined' && typeof email === 'string'
    ? email.trim()
    : '';
  const token = typeof csrfToken !== 'undefined' && typeof csrfToken === 'string'
    ? csrfToken
    : '';
%>
<div class="auth auth--single shell">
  <div class="auth-form">
    <div class="auth-form__intro">
      <h1 class="auth-form__title">Check your email</h1>
      <p class="auth-form__sub">
        We sent an 8-digit code to
        <% if (submittedEmail) { %>
        <strong class="auth-form__email"><%= submittedEmail %></strong>, and it expires in 10 minutes.
        <% } else { %>
        the address you entered, and it expires in 10 minutes.
        <% } %>
      </p>
    </div>

    <a class="btn btn--primary btn--block" href="/verify-email">Enter code</a>

    <form class="auth-resend" method="post" action="/verify-email/resend">
      <input type="hidden" name="_csrf" value="<%= token %>">
      <button class="auth-resend__button" type="submit">Send a new code</button>
    </form>

    <p class="auth-note">Check spam if it does not arrive. You can resend after 60 seconds.</p>

    <p class="form__foot">Back to <a href="/login">sign in</a>.</p>
  </div>
</div>
