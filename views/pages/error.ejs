<div class="error-page shell">
  <p class="eyebrow">Request failed</p>
  <p class="error-page__numeral" aria-hidden="true"><%= status %></p>
  <h1 class="error-page__title"><%= status >= 500 ? 'Something went wrong.' : 'That request did not go through.' %></h1>
  <p class="error-page__message"><%= message %></p>
  <% if (status >= 500) { %>
  <p class="error-page__note">The queue is still running. Try again in a moment.</p>
  <% } %>
  <% if (requestId) { %>
  <p class="error-page__ref">Reference: <span class="mono"><%= requestId %></span></p>
  <% } %>
  <div class="error-page__actions">
    <a class="btn btn--primary" href="/">Back to home</a>
    <% if (user) { %>
    <a class="btn btn--secondary" href="/queue">My queue</a>
    <% } else { %>
    <a class="btn btn--secondary" href="/login">Sign in</a>
    <% } %>
  </div>
</div>
