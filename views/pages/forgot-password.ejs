<div class="auth auth--single shell">
  <div class="auth-form">
    <div class="auth-form__intro">
      <p class="eyebrow">Password help</p>
      <h1 class="auth-form__title">Forgot password</h1>
      <p class="auth-form__sub">Email reset is not connected in this preview.</p>
    </div>

    <div class="form">
      <div class="field">
        <label class="field__label" for="email">Email</label>
        <input
          class="input"
          id="email"
          type="email"
          autocomplete="email"
          inputmode="email"
          placeholder="student@my.cspc.edu.ph"
          aria-describedby="reset-preview-note"
          disabled
        >
      </div>

      <button class="btn btn--primary btn--block" type="button" disabled>Send code</button>

      <p class="auth-note" id="reset-preview-note">For now, reset at the CCIT office with your student ID. This form will send an 8-digit code when account mail is configured.</p>

      <p class="form__foot">Back to <a href="/login">sign in</a>.</p>
    </div>
  </div>
</div>
