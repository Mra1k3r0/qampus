<%
  const errorBag = typeof errors !== 'undefined' && errors && typeof errors === 'object'
    ? errors
    : {};
  const valuesBag = typeof values !== 'undefined' && values && typeof values === 'object'
    ? values
    : {};
  const emailValue = typeof valuesBag.email === 'string' ? valuesBag.email : '';
  const missing = typeof missingFields !== 'undefined' && Array.isArray(missingFields)
    ? missingFields
    : [];
  const emailMissing = missing.includes('email');
  const emailError = errorBag.email || (emailMissing ? 'Enter your email address.' : '');
  const token = typeof csrfToken !== 'undefined' && typeof csrfToken === 'string'
    ? csrfToken
    : '';
  const summaryLines = [];

  if (errorBag.form) {
    summaryLines.push(errorBag.form);
  }

  if (emailMissing) {
    summaryLines.push('Enter your email address.');
  } else if (errorBag.email) {
    summaryLines.push(errorBag.email);
  }
%>
<div class="auth auth--single shell">
  <div class="auth-form">
    <form class="form" method="post" action="/forgot-password" novalidate>
      <div class="auth-form__intro">
        <h1 class="auth-form__title">Forgot password</h1>
        <p class="auth-form__sub">Enter the email on the account and we will send an 8-digit code.</p>
      </div>

      <input type="hidden" name="_csrf" value="<%= token %>">

      <%- include('../partials/error-summary', {
        errors: errorBag,
        lines: summaryLines,
      }) %>

      <div class="field<%= emailError ? ' field--error' : '' %>">
        <label class="field__label" for="email">Email</label>
        <input
          class="input"
          id="email"
          name="email"
          type="email"
          value="<%= emailValue %>"
          autocomplete="email"
          inputmode="email"
          maxlength="160"
          required
          <% if (emailError) { %>aria-describedby="email-error" aria-invalid="true"<% } %>
        >
        <% if (emailError) { %>
        <p class="field__error" id="email-error">
          <%- include('../partials/icon', { name: 'circle-alert', size: 16, title: null }) %>
          <%= emailError %>
        </p>
        <% } %>
      </div>

      <button class="btn btn--primary btn--block" type="submit">Send code</button>

      <p class="form__foot">Back to <a href="/login">sign in</a>.</p>
    </form>
  </div>
</div>
