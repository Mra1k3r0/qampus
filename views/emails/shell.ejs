<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>Qampus</title>
  <style>
    .qampus-code {
      font-size: 44px;
      letter-spacing: 0.14em;
    }
    @media only screen and (max-width: 360px) {
      .qampus-code {
        font-size: 36px;
      }
    }
  </style>
</head>
<body style="margin:0;padding:0;background:#F7F4EC;color:#172033;font-family:'Segoe UI',system-ui,-apple-system,'Helvetica Neue',Arial,sans-serif;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;"><%= preheader %></div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#F7F4EC;">
    <tr>
      <td align="center" style="padding:32px 16px;">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;background:#FDFBF4;border-top:2px solid #B7791F;border-radius:4px;">
          <tr>
            <td style="padding:28px 32px 4px;">
              <p style="margin:0;font-size:14px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#002A7A;">Qampus</p>
            </td>
          </tr>
          <tr>
            <td style="padding:12px 32px 32px;font-size:17px;line-height:1.55;color:#172033;">
              <%- content %>
            </td>
          </tr>
          <tr>
            <td style="padding:0 32px 24px;font-size:12px;line-height:1.5;color:#5B6472;">
              Qampus service desk. This message was sent because of an account action.
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
