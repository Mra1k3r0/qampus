NODE_ENV=development
PORT=3000
DATABASE_PATH=data/cspc_queue.sqlite
SESSION_SECRET=replace-this-with-at-least-32-random-characters
COOKIE_NAME=cspc_queue.sid
SESSION_MAX_AGE_MS=28800000
# Lifetime of a checked "Keep me signed in" session. Default is 30 days in milliseconds.
SESSION_REMEMBER_MAX_AGE_MS=2592000000
LOG_LEVEL=info
# Public origin used in canonical, Open Graph, robots, and sitemap URLs. No trailing slash.
PUBLIC_BASE_URL=http://localhost:3000
# Enforce service open days and hours on join. Set false only for a demo outside office hours.
QUEUE_ENFORCE_HOURS=true
# Check new passwords against the Pwned Passwords range API. On by default outside tests.
PASSWORD_LEAK_CHECK=true
# Set to true only when the app is served over HTTPS.
COOKIE_SECURE=false

# Account mail. Use ethereal locally; production requires brevo.
MAIL_DRIVER=ethereal
MAIL_FROM=Qampus <no-reply@mail.qampus.dpdns.org>
MAIL_REPLY_TO=
BREVO_API_KEY=
# Optional outside production. Dev derives both from SESSION_SECRET when blank.
# Production requires a 32-byte base64 key and a 32+ character pepper.
MAIL_ENCRYPTION_KEY=
AUTH_PEPPER=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Production demo reset escape hatch. Leave unset for normal operation.
# ALLOW_DEMO_RESET=1

# Cloudflare Tunnel. Set TUNNEL=true on the Pterodactyl server.
TUNNEL=false
CLOUDFLARED_TOKEN=
TUNNEL_HOSTNAME=
CLOUDFLARED_VERSION=2026.10.4
# Optional path when cloudflared is already installed in the container.
CLOUDFLARED_BIN=
# Optional cloudflared flags, for example --protocol http2 when UDP is blocked.
CLOUDFLARED_EXTRA_ARGS=
